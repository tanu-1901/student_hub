# ==============================================================================
# StudentPro Production .gitignore
# Prevents sensitive credentials, dependency bloat, logs & OS junk from Git
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# ── Environment & Secret Credentials ─────────────────────────────────────────
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# SSL & Encryption Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ── Logs & Debugging Output ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime Data, Caches & Temporary Storage ─────────────────────────────────
pids
*.pid
*.seed
*.pid.lock
.npm
.cache
.eslintcache
tmp/
temp/
*.tmp
*.bak
scratch/

# Testing & Coverage
coverage/
.nyc_output/

# ── Build & Distribution Artifacts ───────────────────────────────────────────
dist/
build/
out/
.parcel-cache

# ── Operating System Junk ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE & Editor Configuration ───────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
